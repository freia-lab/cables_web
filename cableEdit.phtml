function isblank(s)	{

	if (s == null || s == "")	{
		return true;
	}
	for (var i=0; i<s.length; i++)	{
		var c = s.charAt(i);
		if ((c != ' ') && (c != '\n') && (c != '\t'))
			return false;
	}
	return true;
}

function checkUpdateForm() 	{
	var nr, nblank;

	nblank = 0; 
	if (isblank(document.update.type.value))	
		nblank++;

	if (isblank(document.update.con1.value))	
		nblank++;
	if (isblank(document.update.equip1.value))	
		nblank++;
	if (isblank(document.update.loc1.value))	
		nblank++;

	if (isblank(document.update.con2.value))	
		nblank++;
	if (isblank(document.update.equip2.value))	
		nblank++;
	if (isblank(document.update.loc2.value))	
		nblank++;

	if (isblank(document.update.note.value))	
		nblank++;

	if (nblank == 8)	{
		alert("All cable description fields empty !!!\nAt least one of the description fields must be non-empty.");
		return false;
	}
	return true;
}

function copyForm()	{
	var f = document.update;

	for (i=0; i<f.length; i++)	{
		if (f.elements[i].type == "text")	
			top.window[0].copyPasteValues[f.elements[i].name] = f.elements[i].value;
	}
}

function pasteForm()	{
	var f = document.update;

	for (i=0; i<f.length; i++)	{
		if (f.elements[i].type == "text")	
			f.elements[i].value = top.window[0].copyPasteValues[f.elements[i].name];
	}
}

function updateForm()	{
	var f = document.update;

	if(checkUpdateForm())
		f.submit();
}

function clearForm()	{
	var f = document.update;

	for (i=0; i<f.length; i++)	{
		if (f.elements[i].type == "text")	
			f.elements[i].value = "";
	}
}

function cancelForm()	{

	self.history.back();
}

</SCRIPT>
