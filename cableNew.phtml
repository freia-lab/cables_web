function isblank(s)	{

	if (s == null || s == "")	{
		return true;
	}
	for (var i=0; i<s.length; i++)	{
		var c = s.charAt(i);
		if ((c != ' ') && (c != '\n') && (c != '\t'))
			return false;
	}
	return true;
}

function checkInsertForm() 	{
	var nr, nblank;

	if (isblank(document.insert.nr.value))	{
		alert("Cable nr field can not be empty !!!");
		return false;
	}

	nr = parseInt(document.insert.nr.value);
	if (isNaN(nr))	{
		alert("Bad cable nr !!!");
		return false;
	}
	if (nr < 0 || nr > 999)	{
		alert("Cable nr must be in range 0-999");
		return false;
	}
	nblank = 0; 
	if (isblank(document.insert.type.value))	
		nblank++;
	if (isblank(document.insert.con1.value))	
		nblank++;
	if (isblank(document.insert.equip1.value))	
		nblank++;
	if (isblank(document.insert.loc1.value))	
		nblank++;

	if (isblank(document.insert.con2.value))	
		nblank++;
	if (isblank(document.insert.equip2.value))	
		nblank++;
	if (isblank(document.insert.loc2.value))	
		nblank++;

	if (isblank(document.insert.note.value))	
		nblank++;

	if (nblank == 8)	{
		
		alert("All cable description fields empty !!!\nAt least one of the description fields must be non-empty.");
		return false;
	}
	return true;

}

function copyForm()	{
	var f = document.insert;

	for (i=0; i<f.length; i++)	{
		if (f.elements[i].type == "text")	
			top.window[0].copyPasteValues[f.elements[i].name] = f.elements[i].value;
	}
}

function pasteForm()	{
	var f = document.insert;

	for (i=0; i<f.length; i++)	{
		if (f.elements[i].type == "text" && f.elements[i].name != "nr")	
			f.elements[i].value = top.window[0].copyPasteValues[f.elements[i].name];
	}
}

function clearForm()	{
	var f = document.insert;

	for (i=0; i<f.length; i++)	{
		if (f.elements[i].type == "text")	
			f.elements[i].value = "";
	}
}

function insertForm()	{
	var f = document.insert;

	if (checkInsertForm())
		f.submit();
}

function cancelForm()	{

	self.history.back();
}

